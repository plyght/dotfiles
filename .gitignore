# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Raycast - ignore extensions cache and temp files but keep configs
raycast/.config/raycast/config.json
raycast/.config/raycast/extensions/[0-9a-fA-F]*-[0-9a-fA-F]*-[0-9a-fA-F]*-[0-9a-fA-F]*-[0-9a-fA-F]*/
raycast/.config/raycast/extensions/*/
raycast/.config/raycast/extensions/node_modules
raycast/.config/raycast/ai/

# Claude - ignore heavy files but keep config (only keep CLAUDE.md)
claude/.claude/local/
claude/.claude/backups/
claude/.claude/paste-cache/
claude/.claude/plans/
claude/.claude/sessions/
claude/.claude/tasks/
claude/.claude/readout-cost-cache.json
claude/.claude/readout-pricing.json
claude/.claude/__store.db
claude/.claude/settings.json
claude/.claude/settings.local.json
claude/.claude/plugins/
claude/.claude/projects/
claude/.claude/todos/
claude/.claude/statsig/
claude/.claude/*.log
claude/.claude/cache/
claude/.claude/temp/
claude/.claude/shell-snapshots/
claude/.claude/ide/
claude/.claude/debug/
claude/.claude/file-history/
claude/.claude/history.jsonl
claude/.claude/stats-cache.json
claude/.claude/telemetry/
claude/.claude/transcripts/

# Fish - never track secrets or machine-local history (fish/sync.sh also redacts secret-shaped values)
fish/.config/fish/fish_history
fish/.config/fish/.env
fish/.config/fish/.env.*
fish/.config/fish/**/*secret*
fish/.config/fish/**/*credential*
fish/.config/fish/**/*.pem
fish/.config/fish/**/*.p8
fish/.config/fish/*.bak
fish/.config/fish/*.bak-*
fish/.config/fish/*.bak.*
fish/.config/fish/*.backup-*
fish/.config/fish/**/*.bak
fish/.config/fish/**/*.backup-*

# Pi - ignore auth, sessions, history, and per-extension working data
pi/.pi/agent/auth.json
pi/.pi/agent/auth.json.lock
pi/.pi/agent/*auth*
pi/.pi/agent/*token*
pi/.pi/agent/*secret*
pi/.pi/agent/*credential*
pi/.pi/agent/*.pem
pi/.pi/agent/*.p8
pi/.pi/agent/.env
pi/.pi/agent/.env.*
pi/.pi/agent/*.env
pi/.pi/agent/sessions/
pi/.pi/agent/run-history.jsonl
pi/.pi/agent/memory/
pi/.pi/agent/.extmgr-cache/
pi/.pi/agent/cursor-model-cache.json
pi/.pi/agent/cursor-sdk-context-windows.json
pi/.pi/agent/pi-fff/
pi/.pi/agent/pi-pretty/
# Vendored npm packages produced by localize-pi-packages.mjs (node_modules-equivalent)
pi/.pi/agent/extensions/local-packages/

# Claude - ignore MCP auth cache (machine-local state)
claude/.claude/mcp-needs-auth-cache.json

# Temporary files
*.tmp
*.temp
*~
.#*

# Logs
*.log
logs/

# Cache directories
**/cache/
**/.cache/
**/temp/
**/tmp/

# OS generated files
*.swp
*.swo
*~

# IDE files (but keep actual configs)
.vscode/settings.json
.vscode/launch.json
.vscode/.ropeproject
.idea/workspace.xml
.idea/tasks.xml